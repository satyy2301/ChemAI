{
  "name": "fuel_reactions",
  "description": "Fuel/catalysis reaction benchmarks",
  "tests": [
    {
      "name": "HER hydrogen generation",
      "type": "smarts",
      "reactants": ["O"],
      "rxn_smarts": "[O:1][H:2]>>[H:3][H:4]",
      "conditions": {"temperature_c": 25, "catalyst": "Pt"},
      "base_yield": 0.92,
      "skip_safety": true
    },
    {
      "name": "CO oxidation",
      "type": "smarts",
      "reactants": ["[C-]#[O+]", "O=O"],
      "rxn_smarts": "[C:1]#[O:2].[O:3]=[O:4]>>[O:1]=[C:2]=[O:5]",
      "conditions": {"temperature_c": 200},
      "base_yield": 0.88,
      "skip_safety": true
    },
    {
      "name": "Glucose to ethanol bio",
      "type": "smarts",
      "reactants": ["OC[C@H]1OC(O)[C@H](O)[C@@H](O)[C@@H]1O"],
      "rxn_smarts": "[C:1]([O;H1])[C;H1:2]([O;H1])[C:3]([O;H1])[C:4]([O;H1])[C:5]([O;H1])[C:6]([O;H1])>>[C:1][C;H2:2][O;H1]",
      "conditions": {"temperature_c": 37, "ph": 7.0},
      "base_yield": 0.51
    }
  ]
}
